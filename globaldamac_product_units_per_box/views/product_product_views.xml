<odoo>
    <record id="product_product_form_view_units_per_box" model="ir.ui.view">
        <field name="name">product.product.form.units.per.box</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='detailed_type']" position="after">
                <field name="units_per_box"/>
            </xpath>
        </field>
    </record>

    <!-- Tree view for products showing box info -->
    <record id="product_product_tree_view_units_per_box" model="ir.ui.view">
        <field name="name">product.product.tree.units.per.box</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_code']" position="after">
                <field name="units_per_box"
                       string="Uds/Caja"
                       optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
