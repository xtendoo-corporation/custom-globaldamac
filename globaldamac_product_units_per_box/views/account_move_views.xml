<odoo>
    <!-- Inherit account move form (invoice) to show box information in lines -->
    <record id="view_move_form_units_per_box" model="ir.ui.view">
        <field name="name">account.move.form.units.per.box</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='quantity']" position="attributes">
                <attribute name="string">Unidades</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='quantity']" position="after">
                <field name="units_per_box"
                       string="Uds/Caja"
                       optional="show"/>
                <field name="box_quantity"
                       string="Cajas"
                       optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>

