<odoo>
    <!-- Inherit Sale Order Report to add box quantity column -->
    <template id="report_saleorder_document_units_per_box" inherit_id="sale.report_saleorder_document">
        <!-- Add header for Cajas column -->
        <xpath expr="//thead/tr/th[@name='th_quantity']" position="before">
            <th name="th_box_quantity" class="text-end">
                <span>Cajas</span>
            </th>
        </xpath>
        <!-- Add data for Cajas column -->
        <xpath expr="//tbody//td[@name='td_quantity']" position="replace">
            <td name="td_box_quantity" class="text-end">
                <span t-field="line.box_quantity"/>
            </td>
            <td name="td_quantity" class="text-end">
                <span t-field="line.product_uom_qty">3</span>
                <span t-if="line.product_packaging_id">
                    (
                    <span t-field="line.product_packaging_qty" t-options='{"widget": "integer"}'/>
                    <span t-field="line.product_packaging_id"/>)
                </span>
            </td>
        </xpath>
        <xpath expr="//th[@name='th_taxes']" position="replace">
        </xpath>
        <xpath expr="//td[@name='td_taxes']" position="replace">
        </xpath>
        <xpath expr="//th[@name='th_priceunit']" position="replace">
            <th name="th_priceunit" class="text-end">Precio</th>
        </xpath>
    </template>
</odoo>

